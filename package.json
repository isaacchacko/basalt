{
  "name": "@isaacchacko/basalt",
  "version": "0.1.4",
  "description": "Markdown in, a website that reads like a good math textbook out: remarks in the margin, one viewer for every picture, saves that land in place.",
  "type": "module",
  "license": "MIT",
  "author": "Isaac Chacko",
  "homepage": "https://basalt.isaacchacko.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacchacko/basalt.git"
  },
  "bugs": {
    "url": "https://github.com/isaacchacko/basalt/issues"
  },
  "keywords": [
    "markdown",
    "static-site",
    "digital-garden",
    "astro",
    "tufte",
    "sidenotes",
    "obsidian",
    "quartz"
  ],
  "bin": {
    "basalt": "./bin/basalt.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/markdown/test-hooks.ts",
    "astro.config.ts",
    "tsconfig.json",
    "BASALT.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node bin/basalt.mjs dev examples/showcase",
    "build": "node bin/basalt.mjs build examples/showcase",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/preact": "^6.1.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@isaacchacko/graph": "^0.2.0",
    "@lezer/highlight": "^1.2.5",
    "@viz-js/viz": "^3.31.0",
    "astro": "^7.4.2",
    "chokidar": "^6.0.0",
    "diff": "^9.0.0",
    "flexsearch": "^0.8.212",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "is-absolute-url": "^5.0.0",
    "js-yaml": "^5.5.0",
    "mdast-util-find-and-replace": "^3.0.4",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "^6.4.299",
    "preact": "^11.0.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "sass": "^1.106.1",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "unist-util-visit-parents": "^6.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mermaid": "^12.2.0",
    "typescript": "^7.0.2"
  }
}
