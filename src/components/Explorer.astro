---
// The explorer: the site's notes as a folder tree, in the navbar. Folders
// open and close where you click their chevron, and stay the way you left
// them (localStorage); the whole explorer folds under its title. On a phone
// it's a drawer behind the menu button.
// Entries the site's `layout.explorer.order` lists come first; in a folder
// `layout.explorer.byDate` lists, the rest go newest first.
import ExplorerTree from "./ExplorerTree.astro"
import { words } from "../layouts/words"
import { dateOf, type TreeNode } from "../layouts/notes"
import { layout, ordered } from "../lib/config"

interface Props {
  root: TreeNode
  current: string
  open?: "collapsed" | "open"
  /** the navbar's only part: no title to fold it under, it's just there */
  fixed?: boolean
  /** the home page's entry at the top, by this name */
  home?: string
}
const { root, current, open = "collapsed", fixed = false, home } = Astro.props
const { explorer } = await layout()
// the tree comes sorted folders first, by name; a stable sort keeps that for
// what the order doesn't list, or, in a folder listed by date, newest first
const byName = ordered<TreeNode>(explorer.order, () => 0)
const when = (n: TreeNode) => (n.note ? (dateOf(n.note)?.getTime() ?? -Infinity) : -Infinity)
const byDate = ordered<TreeNode>(explorer.order, (a, b) => when(b) - when(a) || 0)
const dated = new Set((explorer.byDate ?? []).map((f) => f.replace(/^\/+|\/+$/g, "")))
const arrange = (n: TreeNode): TreeNode => ({
  ...n,
  children: [...n.children].sort(dated.has(n.slug) ? byDate : byName).map(arrange),
})
const tree = arrange(root)
const t = await words()
---

<div class:list={["explorer", { "explorer-fixed": fixed }]} data-collapsed={open}>
  <button type="button" class="explorer-toggle mobile-explorer" data-mobile="true" aria-controls="explorer-content" aria-label={t("menu")}>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="lucide-menu">
      <line x1="4" x2="20" y1="12" y2="12"></line>
      <line x1="4" x2="20" y1="6" y2="6"></line>
      <line x1="4" x2="20" y1="18" y2="18"></line>
    </svg>
  </button>
  {
    !fixed && (
      <button type="button" class="title-button explorer-toggle desktop-explorer" data-mobile="false" aria-expanded="true">
        <h2>{t("explorer")}</h2>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="5 8 14 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="fold">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>
    )
  }
  <div id="explorer-content" class="explorer-content" role="group">
    <ul class="explorer-ul overflow">
      {
        home && (
          <li class="explorer-home">
            <a href="/" data-for="index" class:list={{ active: current === "index" }}>
              {home}
            </a>
          </li>
        )
      }
      <ExplorerTree nodes={tree.children} current={current} open={open} />
      <li class="overflow-end"></li>
    </ul>
  </div>
</div>
