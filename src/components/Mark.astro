---
// Basalt's mark (src/lib/mark.ts), in the page's own paper and accent
import { B, depth } from "../lib/mark"
interface Props {
  size?: number
}
const { size = 36 } = Astro.props
---

<svg class="nav-mark-b" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
  <defs><path id="basalt-mark-b" d={B} /></defs>
  {depth.map((t) => <use href="#basalt-mark-b" transform={t} />)}
  <use href="#basalt-mark-b" />
</svg>
