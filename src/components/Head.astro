---
// The page's <head>: its title and description, the tags a link preview
// reads (Open Graph, Twitter), the canonical url at the site's baseUrl, the
// fonts, and the theme, set before the first paint.
import { iconHref } from "../lib/icon"
import { ClientRouter } from "astro:transitions"
import { registry } from "../lib/registry"
import { loadSite } from "../lib/site"
import { layout, paletteCss } from "../lib/config"
import { analyticsHtml } from "../lib/analytics"

interface Props {
  title: string
  description?: string
  /** the page's path, e.g. "/blog/a-post" */
  path: string
  noindex?: boolean
  /** the card a link to the page shows where it's shared: a path in the site, or a url */
  image?: string
}
const { title, description, path, noindex, image } = Astro.props
const { site } = registry()
const cfg = site.config
const fullTitle = title === cfg.title ? title : `${title} · ${cfg.title}`
const desc = description ?? cfg.description
const base = cfg.baseUrl ? `https://${cfg.baseUrl.replace(/\/$/, "")}` : undefined
const url = base ? `${base}${path === "/" ? "/" : path}` : undefined
// behind a password, there's no feed, and no card for a link to show
const locked = (await layout()).password === true
const imageUrl = !locked && image && (/^https?:\/\//.test(image) || !base ? image : base + image)
// the site's palette, over Basalt's (doubled :root, so it wins wherever the
// stylesheets land in the head)
const palette = paletteCss(await layout()).replaceAll(":root", ":root:root")
// the site's analytics, in a built site only
const analytics = analyticsHtml((await layout()).analytics, { built: import.meta.env.PROD, baseUrl: cfg.baseUrl })

// Basalt's type is Palatino, which visitors have (or a clone of it); only the
// code face is fetched, and without holding up the first paint (code shows in
// the system's monospace until it's in). A site's theme.fonts.load brings in
// its own, which do wait: they're its titles and text.
const codeFont = "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap"
const fontSheets = (await layout()).theme.fonts?.load ?? []

// the tab's icon: the site's own (basalt.json "icon", a file in its tree, read
// fresh so a change shows while serving), or Basalt's mark
const icon = iconHref(loadSite(site.dir).config.icon)
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{desc && <meta name="description" content={desc} />}
{url && <link rel="canonical" href={url} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content="Basalt" />
<link rel="icon" href={icon} />
{!locked && <link rel="alternate" type="application/rss+xml" title={cfg.title} href="/rss.xml" />}

<meta property="og:site_name" content={cfg.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:type" content="website" />
{desc && <meta property="og:description" content={desc} />}
{url && <meta property="og:url" content={url} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && image?.startsWith("/og/") && <meta property="og:image:width" content="1200" />}
{imageUrl && image?.startsWith("/og/") && <meta property="og:image:height" content="630" />}
{imageUrl && <meta property="og:image:alt" content={fullTitle} />}
<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
<meta name="twitter:title" content={fullTitle} />
{desc && <meta name="twitter:description" content={desc} />}
{cfg.baseUrl && <meta property="twitter:domain" content={cfg.baseUrl} />}
{url && <meta property="twitter:url" content={url} />}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={codeFont} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={codeFont} /></noscript>
{fontSheets.map((href) => <link rel="stylesheet" href={href} />)}

<!--
  The theme, before anything paints: the reader's choice, else their system's.
  And the first page's arrival (src/client/motion.ts), so its blocks never
  show and then vanish. Inline, since a module script runs too late for both.
-->
<script is:inline>
  ;(() => {
    const root = document.documentElement
    let theme
    try {
      theme = localStorage.getItem("theme")
    } catch {}
    theme ??= matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
    root.setAttribute("saved-theme", theme)
    // wide enough for the side content: notes are drawn there, not inline,
    // from the first paint (src/client/margin.ts confirms it, or undoes it)
    if (matchMedia("(min-width: 1056px)").matches) root.dataset.margin = "beside"
    let hot = false
    try {
      hot = sessionStorage.getItem("basalt:hot") === "1"
      sessionStorage.removeItem("basalt:hot")
    } catch {}
    if (hot) root.dataset.hot = ""
    else if (!matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("basalt-arrive")
  })()
</script>

{palette && <style is:inline set:html={palette} />}

<ClientRouter fallback="swap" />
{analytics && <Fragment set:html={analytics} />}
