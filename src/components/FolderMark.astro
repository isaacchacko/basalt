---
// A folder glyph, beside a folder's title and beside a folder in a list of
// notes, drawn like Basalt's other icons (a 24px outline, in the text's ink).
interface Props {
  size?: string
}
const { size = "0.9em" } = Astro.props
---

<svg
  class="folder-mark"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path
    d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
  ></path>
</svg>

<style>
  .folder-mark {
    display: inline-block;
    flex: none;
    vertical-align: -0.1em;
    margin-right: 0.35em;
    color: var(--gray);
  }
</style>
