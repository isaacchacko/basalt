---
// The theme toggle: a ghost icon button. Its script is src/client/darkmode.ts.
---

<button class="darkmode" type="button" aria-label="Switch theme">
  <svg class="dayIcon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <title>Dark mode</title>
    <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="nightIcon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <title>Light mode</title>
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path>
  </svg>
</button>

<script>
  import "../client/darkmode"
</script>
