---
// A page's date and reading time, in italic under its title.
import { formatDate } from "../layouts/notes"
import { words } from "../layouts/words"

interface Props {
  date?: Date
  minutes?: number
  /** in place of the reading time (a folder's or tag's count) */
  extra?: string
}
const { date, minutes, extra } = Astro.props
const t = await words()
---

{
  (date || minutes || extra) && (
    <p show-comma="true" class="content-meta">
      {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
      {minutes && <span>{t("minRead", { n: minutes })}</span>}
      {extra && <span>{extra}</span>}
    </p>
  )
}
