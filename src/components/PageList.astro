---
// A list of notes (a folder's, a tag's): the date, the title and its
// description, its tags. Dates show as a page's own do (`layout.components.meta`).
import type { Entry } from "../layouts/notes"
import { byDate, formatDate, hrefOf } from "../layouts/notes"
import { layout } from "../lib/config"
import FolderMark from "./FolderMark.astro"

interface Props {
  entries: Entry[]
  limit?: number
  /** keep the entries' order (a folder's the site ordered), not newest first */
  ordered?: boolean
}
const { entries, limit, ordered = false } = Astro.props
const { meta } = (await layout()).components
const shows = (e: Entry) => !!e.date && (meta === "dated" ? e.dated : meta)
let list = ordered ? [...entries] : [...entries].sort(byDate)
if (limit) list = list.slice(0, limit)
---

<ul class="section-ul">
  {
    list.map((e) => (
      <li class="section-li">
        <div class="section">
          <p class="meta">{shows(e) && <time datetime={e.date!.toISOString()}>{formatDate(e.date!)}</time>}</p>
          <div class="desc">
            <h3>
              <a href={hrefOf(e.isFolder ? `${e.slug}/index` : e.slug)} class="internal" data-slug={e.isFolder ? `${e.slug}/index` : e.slug}>
                {e.isFolder && <FolderMark />}
                {e.title}
              </a>
            </h3>
            {e.description && <p class="description">{e.description}</p>}
          </div>
          <ul class="tags">
            {e.tags.map((tag) => (
              <li>
                <a class="internal tag-link" href={`/tags/${tag}`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ul>
