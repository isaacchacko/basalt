---
// The page every note is set in: navigation, the note, and its margin.
import type { CollectionEntry } from "astro:content"
import { registry } from "../lib/registry"

interface Props {
  note: CollectionEntry<"notes">
  headings: { depth: number; slug: string; text: string }[]
}
const { note } = Astro.props
const { site } = registry()
const title = (note.data.title as string | undefined) ?? note.id.split("/").pop()
---

<!doctype html>
<html lang={site.config.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === site.config.title ? title : `${title} · ${site.config.title}`}</title>
  </head>
  <body>
    <main>
      <article>
        <h1>{title}</h1>
        <slot />
      </article>
    </main>
  </body>
</html>
