---
// Every page Basalt makes is set in this: the navbar, the note (or a folder's
// or tag's listing), and the margin. On a wide screen the three sit side by
// side, 56px | 3 parts | 1 part, and the navbar opens out of its 56px.
//
// Each part is a component a site can replace (src/lib/vite.ts), and which
// ones show is the site's layout (src/lib/config.ts).
import type { CollectionEntry } from "astro:content"
import { registry } from "../lib/registry"
import { layout as siteLayout } from "../lib/config"
import { ancestry, backlinksOf, notes, tree, type TreeNode } from "./notes"
import Head from "basalt:components/Head"
import Nav from "basalt:components/Nav"
import Search from "basalt:components/Search"
import Breadcrumbs from "basalt:components/Breadcrumbs"
import ContentMeta from "basalt:components/ContentMeta"
import TagList from "basalt:components/TagList"
import Footer from "basalt:components/Footer"
import Motion from "basalt:components/Motion"
import FolderMark from "../components/FolderMark.astro"
import Margin from "basalt:components/Margin"
import MediaScripts from "basalt:components/MediaScripts"
import { highlightSource } from "../markdown/source"
import { canDrawCards } from "../lib/socialimage"
import { slugifyFilePath, type FilePath } from "../lib/path"
import { blobSha, editTarget, repoPath, serving } from "../lib/edit"
import { historyOn } from "../lib/history"
// KaTeX's own stylesheet and fonts, the installed version rehype-katex renders
// with: only on a page with math (about 8 KB, gzipped, its fonts' faces most of it)
import katexCss from "katex/dist/katex.min.css?url"
import "../styles/base.scss"
import "../styles/basalt.scss"
import "../styles/print.scss"
import "../styles/themed.scss"
import "../styles/gardengraph.scss"
import "../styles/nav.scss"
import "../styles/search.scss"
import "../styles/source.scss"
// the site's own styles/custom.scss, last, over Basalt's
import "basalt:site-styles"

interface Props {
  /** the note the page shows, if it shows one (a folder's index note counts) */
  note?: CollectionEntry<"notes">
  headings?: { depth: number; slug: string; text: string }[]
  /** the page's slug: "blog/a-post", "blog/index", "tags/x", "404" */
  slug: string
  title: string
  /** a folder's page: its title gets the folder mark */
  folder?: boolean
  description?: string
  date?: Date
  /** frontmatter `cssclasses`: classes on the note's article, for a site's styles */
  cssclasses?: string[]
  /** the note gives its own date (else `date` is when its file was made) */
  dated?: boolean
  minutes?: number
  /** said after the date in the note's header (a folder's count) */
  meta?: string
  tags?: string[]
  /** the page's own breadcrumb, when it isn't in the folder tree (a tag) */
  crumb?: string
  breadcrumbs?: boolean
  noindex?: boolean
}
const {
  note,
  headings = [],
  slug,
  title,
  folder = false,
  description,
  date,
  dated = false,
  cssclasses = [],
  minutes,
  meta,
  tags = [],
  crumb,
  breadcrumbs = slug !== "index",
  noindex,
} = Astro.props

const { site } = registry()
const layout = await siteLayout()
const all = await notes()
const root: TreeNode = tree(all)
const trail = ancestry(root, crumb ? "" : slug)
const backlinks = note ? backlinksOf(note.id, all) : []
const source = note?.body !== undefined ? await highlightSource(note.body) : undefined
const lineNumberDigits = String(note?.body?.split("\n").length ?? 0).length
// the card a link to the page shows: the note's own `image`, else Basalt's for it
const ownImage = note?.data && ((note.data as Record<string, unknown>).image ?? (note.data as Record<string, unknown>).socialImage)
const image =
  typeof ownImage === "string" && ownImage.trim()
    ? /^https?:\/\//.test(ownImage)
      ? ownImage
      : "/" + encodeURI(slugifyFilePath(ownImage.trim().replace(/^\/+/, "") as FilePath))
    : layout.socialImages && canDrawCards()
      ? note && !note.id.startsWith("tags/")
        ? `/og/${note.id}.png`
        : // a page with no note of its own (a tag's, a folder's) shows the home page's
          all.some((n) => n.id === "index")
          ? "/og/index.png"
          : undefined
      : undefined
const hasMath = !!note?.rendered?.html.includes('class="katex')
// a note's page edits in place (client/editor.ts): while serving, or built with "edit"
// (an empty note has no body in the store, but a file, empty, all the same)
const noteFile = note && registry().bySlug.get(note.id as never)
const body = note && (note.body ?? (noteFile ? "" : undefined))
const target = body !== undefined ? editTarget(site) : undefined
const edit =
  !target || body === undefined || (target.kind === "github" && !noteFile)
    ? {}
    : {
        "data-edit": target.kind,
        "data-edit-slug": note!.id,
        "data-edit-sha": blobSha(body),
        ...(target.kind === "github"
          ? { "data-edit-repo": target.repo, "data-edit-branch": target.branch, "data-edit-path": repoPath(target, noteFile!.abs) }
          : {}),
      }
// a note's history (client/history.ts): where it's read from, while serving or built
const history = note?.body !== undefined && historyOn(site, note.data as Record<string, unknown>) ? { "data-history": serving() ? "dev" : "built" } : {}
const path = slug === "404" ? "/404" : `/${slug.replace(/(^|\/)index$/, "")}`.replace(/\/$/, "") || "/"
---

<!doctype html>
<html lang={site.config.locale}>
  <head>
    <Head title={title} description={description} path={path} noindex={noindex} image={image} />
    {hasMath && <link rel="stylesheet" href={katexCss} data-basalt-sheet="katex" />}
  </head>
  <body data-slug={slug}>
    <div id="quartz-root" class="page">
      <div id="quartz-body">
        <Nav title={site.config.title} root={root} current={slug} layout={layout} />
        <main class="center">
          <div class="page-header">
            {
              layout.components.search && (
                <header>
                  <Search />
                </header>
              )
            }
            <div class="popover-hint">
              {layout.components.breadcrumbs && breadcrumbs && <Breadcrumbs trail={trail} last={crumb} rootName={layout.breadcrumbs.rootName} />}
              <h1 class="article-title">{folder && <FolderMark size="0.8em" />}{title}</h1>
              {
                (layout.components.meta === "dated" ? dated : layout.components.meta) ? (
                  <ContentMeta date={date} minutes={minutes} extra={meta} />
                ) : (
                  meta && <ContentMeta extra={meta} />
                )
              }
              {layout.components.tags && <TagList tags={tags} />}
            </div>
          </div>
          <article class:list={["popover-hint", ...cssclasses]} {...edit} {...history}>
            <slot />
          </article>
          <slot name="listing" />
          {source && <div class="page-source" style={`--digits: ${lineNumberDigits}`} set:html={source} />}
          <div class="page-footer"></div>
        </main>
        <div class="right sidebar">
          {note && <Margin note={note} headings={headings} backlinks={backlinks} />}
        </div>
        {layout.components.footer && <Footer links={layout.footer.links} />}
      </div>
    </div>
    <MediaScripts />
    <Motion />
    <script>
      import "../client/router"
      import "../client/gardengraph"
    </script>
  </body>
</html>
