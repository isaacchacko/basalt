---
// A page that isn't there.
import Page from "../layouts/Page.astro"
import { words } from "../layouts/words"
const t = await words()
---

<Page slug="404" title={t("notFound")} breadcrumbs={false} noindex>
  <p>{t("notFoundBody")} <a href="/" class="internal">{t("backToStart")}</a></p>
</Page>
