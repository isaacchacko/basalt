---
// Every tag, each with the first of its notes; a line saying so when there are none.
import Page from "../../layouts/Page.astro"
import PageList from "basalt:components/PageList"
import { notes, tagIndex, toEntry } from "../../layouts/notes"
import { layout } from "../../lib/config"
import { say } from "../../lib/strings"

const index = tagIndex(await notes())
const { strings } = await layout()
const LIMIT = 10
---

<Page slug="tags/index" title={say(strings, "tags")} meta={say(strings, "tagCount", { n: index.size })} crumb={say(strings, "tags")}>
  <div class="page-listing tag-index" slot="listing">
    {index.size === 0 && <p class="tag-empty">{say(strings, "noTags")}</p>}
    {
      [...index].map(([tag, list]) => (
        <section>
          <h2>
            <a class="internal tag-link" href={`/tags/${tag}`}>
              {tag}
            </a>
          </h2>
          <p class="tag-count">
            {say(strings, "taggedCount", { n: list.length })}
            {list.length > LIMIT && say(strings, "showingFirst", { n: LIMIT })}
          </p>
          <PageList entries={list.map(toEntry)} limit={LIMIT} />
        </section>
      ))
    }
  </div>
</Page>

<style>
  .tag-empty {
    margin: 0;
    color: var(--gray);
  }
</style>
