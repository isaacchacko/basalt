---
// One tag's page: its notes, newest first, and the words of a tags/<tag>.md
// note if the site has one.
import { render } from "astro:content"
import Page from "../../layouts/Page.astro"
import PageList from "basalt:components/PageList"
import { descriptionOf, notes, tagIndex, toEntry, type Note } from "../../layouts/notes"
import { layout } from "../../lib/config"
import { say } from "../../lib/strings"

export async function getStaticPaths() {
  const all = await notes()
  return [...tagIndex(all)].map(([tag, list]) => ({
    params: { tag },
    props: { tag, list, about: all.find((n) => n.id === `tags/${tag}`) },
  }))
}

const { tag, list, about } = Astro.props as { tag: string; list: Note[]; about?: Note }
const Content = about ? (await render(about)).Content : undefined
const { strings } = await layout()
---

<Page
  slug={`tags/${tag}`}
  title={say(strings, "tag", { tag })}
  description={about && descriptionOf(about)}
  meta={say(strings, "taggedCount", { n: list.length })}
  crumb={`#${tag}`}
>
  {Content && <Content />}
  <div class="page-listing" slot="listing">
    <PageList entries={list.map(toEntry)} />
  </div>
</Page>
