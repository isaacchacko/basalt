{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "examples/*/.basalt"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "paths": { "@basalt/*": ["./src/*"], "@site/*": ["./examples/showcase/*"] }
  }
}
